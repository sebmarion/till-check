# Till Check — systemd unit
# Deploy: cp till-check.service /etc/systemd/system/ && systemctl enable --now till-check
#
# Single-user, low-traffic cash reconciliation service. Binds 127.0.0.1 only;
# nginx proxies the public /till/ route. Data persists in data/till.sqlite.

[Service]
Description=Till Check — daily bistro cash reconciliation
User=seb
WorkingDirectory=/home/seb/projects/bistrot/till-check
ExecStart=/home/seb/.local/bin/node /home/seb/projects/bistrot/till-check/server.mjs
Environment=TILL_PORT=3401
Environment=TILL_BIND=127.0.0.1
Environment=TILL_DB=/home/seb/projects/bistrot/till-check/data/till.sqlite
Restart=on-failure
RestartSec=5
# Hardening (does not break node:sqlite or the HTTP server)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
